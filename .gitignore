# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Entorno virtual. OJO: este proyecto vive dentro de OneDrive.
# El venv NO debe crearse acá adentro — ver UV_PROJECT_ENVIRONMENT en el README.
.venv/
venv/

# --- Datos y artefactos pesados ---------------------------------------------
# Nada de esto va al repo, y menos aún debería sincronizarse a la nube.
mlruns/
mlartifacts/
# El backend de MLflow pasó de filesystem a SQLite (ver ml/forecast.py) y el
# ignore se quedó en el nombre viejo: data/mlflow.db estuvo versionada sin
# quererlo. Es un binario de ~1 MB que cambia en CADA forecast, y este repo vive
# dentro de OneDrive.
data/mlflow.db
data/raw/
data/public/cache/
*.faiss
*.index
models/
*.pkl
# El indice paso de chunks.pkl a chunks.json al dejar de usar pickle
# (que ejecuta codigo al deserializar). Sigue siendo un artefacto de
# build --se rehace con `rag-build`-- asi que sigue fuera del repo: el
# cambio de formato no lo convirtio en fuente.
data/indice/chunks.json
*.joblib

# --- Secretos ---------------------------------------------------------------
.env
.env.local
*.pem

# --- Node / frontend --------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
# tsconfig.node.json usa emitDeclarationOnly (lo exige allowImportingTsExtensions
# sin noEmit) para poder ser referenciado por project references — efecto
# colateral: cada "tsc -b" (y por lo tanto cada "npm run build") deja este
# .d.ts suelto en la raíz de apps/web. Es un artefacto de build, no fuente.
apps/web/vite.config.d.ts

# --- SO / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Parciales del eval: el resultado que vale es el de eval/corridas/.
eval/checkpoints/
