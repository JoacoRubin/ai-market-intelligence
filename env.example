# Copiar a .env y ajustar. El .env NO se versiona (ver .gitignore).
#
# Estas credenciales son de desarrollo local exclusivamente. El proyecto corre
# entero en local y no expone servicios a la red; aun así, no reutilices esta
# contraseña en ningún otro lado.

# Solo SQL Server y los procesos explícitos de init/seed usan esta identidad.
# docker-compose NO la inyecta en API ni worker.
MSSQL_SA_PASSWORD=Dev_Local_2026!
MSSQL_SERVER=localhost,1433
MSSQL_DB=ami

# Usuario read-only que usan las tools del agente.
# El agente NUNCA se conecta con sa: sus tools solo pueden leer.
MSSQL_APP_USER=ami_reader
MSSQL_APP_PASSWORD=Reader_Local_2026!

# core/db.py arma la conexión con las variables anteriores; no usa un DSN.

# LLM local
OLLAMA_HOST=http://localhost:11434
# qwen3:4b con `think` apagado: 5/5 en routing a 12,8 s y sintesis en
# 60,9 s. Ver la revision de ADR-003. Con thinking prendido este mismo
# modelo no termina: se come el timeout de 300 s en los dos nodos.
OLLAMA_MODEL=qwen3:4b

# Jobs y almacén de análisis (ADR-012).
#   memoria (default) → el análisis corre dentro del proceso de la API y se
#                       guarda en su memoria. Sin infraestructura, pero se
#                       pierde al reiniciar y no se comparte entre procesos.
#   redis             → el análisis se encola y lo corre `apps/jobs/worker.py`
#                       en otro proceso; el resultado se guarda en Redis.
#
# Una sola variable elige las DOS cosas (cola y almacén) a propósito: la
# combinación mezclada —cola en Redis, almacén en memoria— dejaría al worker
# escribiendo el resultado en su propio proceso, y la API respondería
# "pendiente" para siempre sobre un análisis ya terminado.
#
# En docker-compose esto lo pisa el servicio (ahí siempre es redis).
JOBS_BACKEND=memoria
# Compose pisa esta URL con el hostname interno `redis`. El servicio no publica
# 6379 al host: los jobs RQ serializados con pickle no deben quedar accesibles
# desde la LAN. En modo local `memoria`, esta variable no se usa.
REDIS_URL=redis://localhost:6379/0

# SEC EDGAR (situación financiera de empresas externas — ADR-014). Gratis,
# sin key, sin límite diario — pero la SEC exige un User-Agent con contacto
# real o bloquea la IP. Cambiá el email por el tuyo; el valor de acá abajo
# solo sirve para desarrollo local ocasional.
SEC_EDGAR_USER_AGENT=ai-market-intelligence contacto@ejemplo.com

# Observability (ADR-009). OPCIONAL y apagado por default: en false no hay
# tráfico a LangSmith, cero costo, cero tarjeta. Es la ÚNICA excepción al
# "costo cero" del README, y es consciente: el free tier corta a las 5.000
# trazas/mes y pide tarjeta en archivo para seguir. Sale de
# smith.langchain.com (Settings → API Keys).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-market-intelligence
